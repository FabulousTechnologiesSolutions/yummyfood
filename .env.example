# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Database
POSTGRES_DB=foodapp
POSTGRES_USER=foodapp
POSTGRES_PASSWORD=foodapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_DAYS=7
JWT_REFRESH_DAYS=30

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FFmpeg (video HLS transcoding; use system PATH locally, /usr/bin/* in Docker)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=foodapp-media
CLOUDFLARE_R2_PUBLIC_URL=https://your-account.r2.dev
USE_LOCAL_MEDIA=true

# Frontend
FRONTEND_URL=http://localhost:3000

# Production API (used in OpenAPI servers list)
API_BASE_URL=https://propertymanage-be.thefabulousshow.com

# Notifications
NOTIFICATION_LEAD_THROTTLE_MINUTES=15
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=core/cred.json
